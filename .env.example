# BANCO DE DADOS (MySQL HostGator ou local)
DATABASE_URL="mysql://usuario:senha@host:3306/nome_banco?connection_limit=3&pool_timeout=10&connect_timeout=10"

# AUTENTICAÇÃO (NextAuth)
NEXTAUTH_SECRET="gere-uma-chave-forte-com-openssl-rand-base64-32"
NEXTAUTH_URL="https://belezuranews.egencymkt.com.br"
AUTH_TRUST_HOST="true"

# URL PÚBLICA DO SITE
NEXT_PUBLIC_SITE_URL="https://belezuranews.egencymkt.com.br"

# SEGURANÇA E PRIVACIDADE (LGPD)
SECURITY_IP_SALT="insira_uma_chave_aleatoria_para_salt_de_ip"

# GOOGLE ANALYTICS 4
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# SEED INICIAL DO ADMIN
INITIAL_ADMIN_PASSWORD="SuaSenhaInicialAdmin2026"
